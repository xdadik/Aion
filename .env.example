# Aion Hand provider configuration
# Keep real credentials in your shell/secret manager, never in Git.
AION_PROVIDER=openai
AION_MODEL=gpt-4o-mini
AION_TIMEOUT=120
AION_MAX_TOKENS=4096
AION_TEMPERATURE=0.7

# Provider-specific credentials
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_API_KEY=

# Optional OpenAI-compatible endpoint
# AION_API_BASE=https://example.com/v1

# Runtime controls
AION_SECURITY_ENABLED=true
AION_SANDBOX_ENABLED=true
AION_MCP_ENABLED=true
AION_GATEWAY_ENABLED=false
AION_CRON_ENABLED=true
AION_LOG_LEVEL=INFO
