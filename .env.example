# Aion Hand — Environment Configuration
# Copy to .env and fill in your keys. All vars are optional; defaults are shown.
# See docs/FAQ.md and aion_core/config/manager.py for full reference.

# ── Provider ──────────────────────────────────────────────────────────
AION_PROVIDER=openai              # openai | anthropic | google | openrouter | ollama | custom
AION_MODEL=gpt-4o
AION_API_KEY=sk-your-key-here
AION_API_BASE=                      # custom base URL (for custom provider)
AION_TEMPERATURE=0.7
AION_MAX_TOKENS=4096
AION_TIMEOUT=120

# Provider-specific keys (alternative to AION_API_KEY)
OPENAI_API_KEY=sk-your-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here
GOOGLE_API_KEY=AIza-your-key-here
OPENROUTER_API_KEY=sk-or-your-key-here
OLLAMA_BASE_URL=http://localhost:11434

# ── Paths & Profiles ──────────────────────────────────────────────────
AION_HOME=~/.aion-hand
AION_PROFILE=default
AION_DATA_DIR=
AION_MEMORY_DIR=
AION_SKILLS_DIR=

# ── Logging ───────────────────────────────────────────────────────────
AION_LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
AION_DEBUG=false

# ── Security ──────────────────────────────────────────────────────────
AION_SECURITY_ENABLED=true
AION_SANDBOX_ENABLED=true
AION_SANDBOX_TIMEOUT=30

# ── Features ──────────────────────────────────────────────────────────
AION_MCP_ENABLED=true
AION_GATEWAY_ENABLED=false
AION_CRON_ENABLED=false

# ── Messaging (when gateway enabled) ──────────────────────────────────
AION_TELEGRAM_BOT_TOKEN=
AION_TELEGRAM_CHAT_ID=
AION_DISCORD_BOT_TOKEN=
AION_SLACK_BOT_TOKEN=xoxb-your-token
AION_SLACK_APP_TOKEN=xapp-your-token
AION_SLACK_CHANNEL=#general
